{
  "name": "pm-lite",
  "version": "1.0.0",
  "description": "Welcome to your new CAP project.",
  "main": "index.js",
  "scripts": {
    "start": "cds-serve",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch-pm-lite-ui": "cds watch --open pm.lite.pmliteui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy pm-lite --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arao-myspace/pm-lite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/arao-myspace/pm-lite/issues"
  },
  "homepage": "https://github.com/arao-myspace/pm-lite#readme",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.19.0",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "cds": {
    "server": {
      "index": true
    },
    "fiori": {
      "preview": true
    },
    "[development]": {
      "requires": {
        "auth": {
          "kind": "mocked",
          "users": {
            "jan_kowalski": {
              "roles": [
                "Pracownik"
              ]
            },
            "anna_nowak": {
              "roles": [
                "Kierownik",
                "Pracownik"
              ]
            }
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/pm-lite-ui"
  ]
}
